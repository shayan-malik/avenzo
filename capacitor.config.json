{
  "appId": "com.avenzo.app",
  "appName": "Avenzo",
  "webDir": "dist",
  "server": {
    "url": "https://avenzo-plum.vercel.app/",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}